# Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_SESSION_TOKEN=  # Optional, for temporary credentials

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
ENVIRONMENT=development

# =============================================================================
# DATABASE CONFIGURATION (DynamoDB)
# =============================================================================
PATIENTS_TABLE=healthcare-patients
SESSIONS_TABLE=healthcare-sessions
APPOINTMENTS_TABLE=healthcare-appointments
METRICS_TABLE=healthcare-metrics

# =============================================================================
# AMAZON BEDROCK CONFIGURATION
# =============================================================================
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_FALLBACK_MODEL_ID=amazon.titan-text-premier-v1:0
BEDROCK_MAX_TOKENS=4000
BEDROCK_TEMPERATURE=0.1

# =============================================================================
# AMAZON SAGEMAKER CONFIGURATION
# =============================================================================
SAGEMAKER_REGION=us-east-1
SAGEMAKER_SYMPTOM_ENDPOINT=healthcare-symptom-analyzer
SAGEMAKER_RISK_ENDPOINT=healthcare-risk-predictor
SAGEMAKER_HEALTH_SCORER_ENDPOINT=healthcare-health-scorer

# =============================================================================
# AMAZON COMPREHEND MEDICAL CONFIGURATION
# =============================================================================
COMPREHEND_MEDICAL_REGION=us-east-1

# =============================================================================
# AMAZON TEXTRACT CONFIGURATION
# =============================================================================
TEXTRACT_REGION=us-east-1

# =============================================================================
# AMAZON S3 CONFIGURATION
# =============================================================================
S3_BUCKET_DOCUMENTS=healthcare-ai-documents
S3_BUCKET_MODELS=healthcare-ai-models
S3_REGION=us-east-1

# =============================================================================
# AMAZON COGNITO CONFIGURATION
# =============================================================================
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=your-32-char-encryption-key-here
PASSWORD_SALT=your-password-salt-here

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_X_RAY=true

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# =============================================================================
# CACHE CONFIGURATION (Redis - Optional)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=3600

# =============================================================================
# EMAIL CONFIGURATION (SES - Optional)
# =============================================================================
SES_REGION=us-east-1
FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
CLOUDWATCH_LOG_GROUP=/aws/lambda/healthcare-ai-api
ENABLE_DETAILED_METRICS=true
ALARM_EMAIL=alerts@yourdomain.com

# =============================================================================
# EXTERNAL API CONFIGURATION (Optional)
# =============================================================================
FHIR_SERVER_URL=https://your-fhir-server.com/fhir
PHARMACY_API_KEY=your-pharmacy-api-key
INSURANCE_VERIFICATION_API_KEY=your-insurance-api-key

# =============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# =============================================================================
ENABLE_MOCK_SERVICES=false
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!
DEMO_MODE=false

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
DATABASE_CONNECTION_TIMEOUT=10
MODEL_INFERENCE_TIMEOUT=60

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_SYMPTOM_ANALYSIS=true
ENABLE_RISK_PREDICTION=true
ENABLE_DOCUMENT_PROCESSING=true
ENABLE_APPOINTMENT_SCHEDULING=true
ENABLE_MEDICATION_CHECKING=true
ENABLE_EMERGENCY_DETECTION=true
ENABLE_VOICE_INPUT=false
ENABLE_VIDEO_CONSULTATION=false

# =============================================================================
# COMPLIANCE CONFIGURATION
# =============================================================================
HIPAA_COMPLIANT_MODE=true
AUDIT_LOGGING_ENABLED=true
DATA_RETENTION_DAYS=2555  # 7 years
ENABLE_DATA_ENCRYPTION=true

# =============================================================================
# LOCALIZATION CONFIGURATION
# =============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de
DEFAULT_TIMEZONE=UTC
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm:ss

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=healthcare-ai-backups